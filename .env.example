# ====== Telegram ======
TELEGRAM_BOT_TOKEN=123456:ABC-DEF
TELEGRAM_ADMIN_IDS=111111111,222222222

# ====== PasarGuard panel ======
PASARGUARD_BASE_URL=https://panel.example.com
PASARGUARD_USERNAME=admin
PASARGUARD_PASSWORD=changeme
# گروه/گروه‌های پیش‌فرض که هر کاربر جدید به آن‌ها اضافه می‌شود (با کاما جدا کن)
PASARGUARD_DEFAULT_GROUP_IDS=1

# ====== Tetrapay ======
TETRAPAY_API_KEY=your-api-key
TETRAPAY_BASE_URL=https://api.tetrapay.io
# سکرت webhook برای صحت‌سنجی کال‌بک (اگر تتراپی امضا برمی‌گرداند)
TETRAPAY_WEBHOOK_SECRET=
# آدرس عمومی سرور تو که تتراپی به آن callback می‌زند
PUBLIC_BASE_URL=https://yourdomain.com

# ====== Webhook server ======
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080

# ====== DB ======
DB_PATH=./data.db
