# ─── ربات تلگرام ─────────────────────────────────────────────────────────────
# توکن ربات از @BotFather
TELEGRAM_BOT_TOKEN=

# آی‌دی عددی حساب تلگرام ادمین (از @userinfobot بگیر)
ADMIN_TELEGRAM_ID=

# ─── درگاه پرداخت tetra98 ────────────────────────────────────────────────────
# کلید API از داشبورد tetra98.com
TETRA_API_KEY=

# ─── پنل PasarGuard ──────────────────────────────────────────────────────────
# آدرس پنل با پورت، بدون / انتهایی
PASARGUARD_URL=https://your-panel.com:8000

# یوزر و پسورد ادمین پنل
PASARGUARD_USERNAME=admin
PASARGUARD_PASSWORD=

# شناسه گروه VLESS WS NOTLS در پنل (از بخش Groups پنل پیدا کن)
PASARGUARD_GROUP_ID=1

# ─── وب‌سرور webhook ─────────────────────────────────────────────────────────
# دامنه عمومی سرور با HTTPS، بدون / انتهایی
# tetra98 به این آدرس callback می‌فرسته
WEBHOOK_DOMAIN=https://your-domain.com

# پورت داخلی که FastAPI روش listen می‌کنه (Nginx این پورت رو proxy می‌کنه)
WEBHOOK_PORT=8080

# ─── دیتابیس ─────────────────────────────────────────────────────────────────
DB_PATH=./orders.db
