[Unit]
Description=Peech V2Ray Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/peech-bot
EnvironmentFile=/opt/peech-bot/.env
ExecStart=/opt/peech-bot/.venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=peech-bot
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
